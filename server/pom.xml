<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>net.schwehla.matrosdms</groupId>
        <artifactId>parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>server</artifactId>
    <name>Matrosdms Server</name>
    <properties>
        <start-class>net.schwehla.matrosdms.MatrosSpringbootApplication</start-class>
        <app.name>MatrosDMS</app.name>
        <app.vendor>Matrosdms</app.vendor>
        <app.description>Matrosdms Document Management System</app.description>
        <jpackage.version>1.0.0</jpackage.version>

        <!-- Java & Compiler -->
        <java.version>25</java.version>

        <!-- 3rd Party Dependencies (Not Managed by Spring Boot) -->
        <hibernate-search.version>7.1.0.Final</hibernate-search.version>
        <db-scheduler.version>15.0.0</db-scheduler.version>
        <tika.version>3.1.0</tika.version>
        <pdfbox.version>3.0.6</pdfbox.version>
        <jjwt.version>0.12.6</jjwt.version>
        <apache-mime4j.version>0.8.13</apache-mime4j.version>
        <commons-compress.version>1.28.0</commons-compress.version>
        <xz.version>1.11</xz.version>
        <java-uuid-generator.version>5.1.0</java-uuid-generator.version>
        <springdoc.version>2.8.4</springdoc.version>
        <jakarta-mail.version>2.0.1</jakarta-mail.version>

        <opennlp.version>2.5.3</opennlp.version>
        <ahocorasick.version>0.6.3</ahocorasick.version>

        <!-- Note: Caffeine, H2, Flyway, and base Jakarta APIs ARE managed by Spring Boot -->
    </properties>
    <dependencies>
        <!-- Spring Boot Starters -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-cache</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- TEXT ANALYSIS TOOLS -->
        <dependency>
            <groupId>org.apache.opennlp</groupId>
            <artifactId>opennlp-tools</artifactId>
            <version>${opennlp.version}</version>
        </dependency>
        <dependency>
            <groupId>org.ahocorasick</groupId>
            <artifactId>ahocorasick</artifactId>
            <version>${ahocorasick.version}</version>
        </dependency>

        <!-- Database -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- Hibernate Search (Not managed by Spring Boot) -->
        <dependency>
            <groupId>org.hibernate.search</groupId>
            <artifactId>hibernate-search-mapper-orm</artifactId>
            <version>${hibernate-search.version}</version>
        </dependency>
        <dependency>
            <groupId>org.hibernate.search</groupId>
            <artifactId>hibernate-search-backend-lucene</artifactId>
            <version>${hibernate-search.version}</version>
        </dependency>

        <!-- Scheduling (Not managed by Spring Boot) -->
