        </dependency>
        <dependency>
            <groupId>com.github.ben-manes.caffeine</groupId>
            <artifactId>caffeine</artifactId>
        </dependency>

        <!-- File Processing -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-compress</artifactId>
            <version>${commons-compress.version}</version>
        </dependency>
        <dependency>
            <groupId>org.tukaani</groupId>
            <artifactId>xz</artifactId>
            <version>${xz.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-core</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.tika</groupId>
            <artifactId>tika-parsers-standard-package</artifactId>
            <version>${tika.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.pdfbox</groupId>
            <artifactId>pdfbox</artifactId>
            <version>${pdfbox.version}</version>
        </dependency>

        <!-- Development Tools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-context-indexer</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Test Dependencies -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>
        <dependency>
            <groupId>com.google.jimfs</groupId>
            <artifactId>jimfs</artifactId>
            <version>1.3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <finalName>${project.artifactId}-${project.version}</finalName>
        <plugins>
            <!-- Compiler Configuration -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <parameters>true</parameters>
                    <release>${java.version}</release>
                    <!-- Preview features are deliberately off: nothing in this codebase uses a preview
                         API, and the flag has to be repeated at runtime by every launcher (jar, Docker,
                         jpackage), which is a standing trap. javac also rejects it whenever the JDK is
                         newer than the release level, so it broke the build on every JDK bump. -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.mapstruct</groupId>
                            <artifactId>mapstruct-processor</artifactId>
                            <version>${mapstruct.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                            <version>${spring-boot.version}</version>
                        </path>
                        <path>
                            <groupId>org.springframework</groupId>
                            <artifactId>spring-context-indexer</artifactId>
                            <version>6.2.3</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
                <configuration>
                    <filesets>
                        <fileset>
                            <directory>${project.build.directory}/portable</directory>
                        </fileset>
                    </filesets>
                </configuration>
            </plugin>
            <!-- Spring Boot Plugin -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                    <excludes>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-configuration-processor</artifactId>
                        </exclude>
                        <exclude>
                            <groupId>org.springframework.boot</groupId>
                            <artifactId>spring-boot-devtools</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <!-- Copy Frontend Resources -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-frontend-resources</id>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <phase>prepare-package</phase>
                        <configuration>
                            <outputDirectory>${project.build.directory}/classes/static</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>../frontend/dist</directory>
                                    <filtering>false</filtering>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- Create Plugin API JAR -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>plugin-api-jar</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                        <phase>package</phase>
                        <configuration>
                            <classifier>plugin-api</classifier>
                            <includes>
                                <include>net/schwehla/matrosdms/plugin/**</include>
                                <include>net/schwehla/matrosdms/domain/**</include>
                                <include>com/fasterxml/jackson/annotation/**</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
    <profiles>
        <!-- `mvn -Pspec verify -DskipTests` → boots the app on a throwaway in-memory
             (H2/PostgreSQL-mode) DB on port 9099, pulls /v3/api-docs, writes
             ../spec/openapi.json, then stops. Refreshes the OpenAPI spec without a
             manual run+curl and without touching the real workspace/DB. Feed
             `npm run generate` afterwards for the TS types. -->
        <profile>
            <id>spec</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <id>spec-start</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>start</goal></goals>
                                <configuration>
                                    <arguments>
                                        <argument>--server.port=9099</argument>
                                        <argument>--spring.datasource.url=jdbc:h2:mem:specgen;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</argument>
                                        <argument>--app.base-path=./target/specgen-data</argument>
                                        <argument>--app.start-browser=false</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>spec-stop</id>
                                <phase>post-integration-test</phase>
                                <goals><goal>stop</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springdoc</groupId>
                        <artifactId>springdoc-openapi-maven-plugin</artifactId>
                        <version>1.4</version>
                        <executions>
                            <execution>
                                <id>spec-generate</id>
                                <phase>integration-test</phase>
                                <goals><goal>generate</goal></goals>
                            </execution>
                        </executions>
                        <configuration>
                            <!-- WebConfig adds /api to every @RestController, including
                                 springdoc's own docs controller, so the spec lives under /api -->
                            <apiDocsUrl>http://localhost:9099/api/v3/api-docs</apiDocsUrl>
                            <outputFileName>openapi.json</outputFileName>
                            <outputDir>${project.basedir}/../spec</outputDir>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- `mvn -Pddl verify -DskipTests` → boots the app on a throwaway in-memory
             (H2/PostgreSQL-mode) DB on port 9099, has Hibernate export the
             entity-derived schema to ../spec/matros.ddl, then stops. Flyway still
             owns the live schema (ddl-auto=none); this profile only flips the JPA
             schema-generation script action from `none` to `create` so the DDL is
             regenerated from the entities without touching the real workspace/DB.
             Use the output to author/update the Flyway V*__*.sql migrations. -->
        <profile>
            <id>ddl</id>
            <build>
                <plugins>
                    <!-- Hibernate opens the schema-generation create-target in APPEND
                         mode, so wipe any prior matros.ddl first — otherwise each run
                         concatenates another full copy onto the file. Declared before
                         the spring-boot plugin so it runs first in pre-integration-test. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>ddl-clean</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <delete file="${project.basedir}/../spec/matros.ddl"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.springframework.boot</groupId>
                        <artifactId>spring-boot-maven-plugin</artifactId>
                        <version>${spring-boot.version}</version>
                        <executions>
                            <execution>
                                <id>ddl-start</id>
                                <phase>pre-integration-test</phase>
                                <goals><goal>start</goal></goals>
                                <configuration>
                                    <arguments>
                                        <argument>--server.port=9099</argument>
                                        <argument>--spring.datasource.url=jdbc:h2:mem:ddlgen;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1</argument>
                                        <argument>--spring.jpa.properties.jakarta.persistence.schema-generation.scripts.action=create</argument>
                                        <argument>--spring.jpa.properties.jakarta.persistence.schema-generation.scripts.create-target=${project.basedir}/../spec/matros.ddl</argument>
                                        <argument>--app.base-path=./target/ddlgen-data</argument>
                                        <argument>--app.start-browser=false</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>ddl-stop</id>
                                <phase>post-integration-test</phase>
                                <goals><goal>stop</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <profile>
            <id>with-frontend</id>
            <dependencies>
                <!-- Only depend on frontend when profile is active -->
                <dependency>
                    <groupId>net.schwehla.matrosdms</groupId>
                    <artifactId>frontend</artifactId>
                    <version>${project.version}</version>
                    <type>pom</type>
                    <scope>provided</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>windows-portable</id>
            <build>
                <plugins>
                    <!-- 1. Stage the jar that jpackage will wrap. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-jpackage-input</id>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <phase>package</phase>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <!-- 2. Render the app icon from MatrosBadge, so no binary can drift from the brand. -->
                            <execution>
                                <id>generate-icon</id>
                                <goals><goal>exec</goal></goals>
                                <phase>package</phase>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-cp</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>net.schwehla.matrosdms.desktop.IconGenerator</argument>
                                        <argument>${project.build.directory}/icon/matrosdms.ico</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                            <!-- 3. Wrap it up. No win-console flag: the app launches windowed and lives in the
                                 system tray (see TrayLauncher); the tray's log window replaces the console. -->
                            <execution>
                                <id>jpackage-portable</id>
                                <goals><goal>exec</goal></goals>
                                <phase>package</phase>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--name</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${jpackage.version}</argument>
                                        <argument>--description</argument>
                                        <argument>${app.description}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${app.vendor}</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.build.directory}/icon/matrosdms.ico</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/portable</argument>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Xmx2048m</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dspring.profiles.active=prod</argument>
                                        <!-- What makes the tray and splash possible at all: Spring Boot otherwise
                                             forces headless=true and AWT can never open a window. -->
                                        <argument>--java-options</argument>
                                        <argument>-Djava.awt.headless=false</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-assembly-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>create-portable-zip</id>
                                <goals>
                                    <goal>single</goal>
                                </goals>
                                <phase>package</phase>
                                <configuration>
                                    <descriptors>
                                        <descriptor>src/assembly/portable-tar.xml</descriptor>
                                    </descriptors>
                                    <appendAssemblyId>true</appendAssemblyId>
                                    <finalName>${app.name}-${project.version}</finalName>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Linux is not a second-class target: the same self-contained app-image as Windows, with a
             bundled runtime, the branded icon and a non-headless launch, so the tray, the splash and
             the log window all work. Unpack and run; no JDK needed. -->
        <profile>
            <id>linux-portable</id>
            <build>
                <plugins>
                    <!-- 1. Stage the jar that jpackage will wrap. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-jpackage-input</id>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <phase>package</phase>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <!-- 2. Render the app icon from MatrosBadge, so no binary can drift from the brand. -->
                            <execution>
                                <id>generate-icon</id>
                                <goals><goal>exec</goal></goals>
                                <phase>package</phase>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-cp</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>net.schwehla.matrosdms.desktop.IconGenerator</argument>
                                        <argument>${project.build.directory}/icon/matrosdms.png</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                            <execution>
                                <id>jpackage-linux-portable</id>
                                <goals><goal>exec</goal></goals>
                                <phase>package</phase>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <argument>--name</argument>
                                        <argument>${app.name}</argument>
                                        <argument>--app-version</argument>
                                        <argument>${jpackage.version}</argument>
                                        <argument>--description</argument>
                                        <argument>${app.description}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${app.vendor}</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.build.directory}/icon/matrosdms.png</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/linux-image</argument>
                                        <argument>--type</argument>
                                        <argument>app-image</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Xmx2048m</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dspring.profiles.active=prod</argument>
                                        <!-- What makes the tray and splash possible at all: Spring Boot otherwise
                                             forces headless=true and AWT can never open a window. -->
                                        <argument>--java-options</argument>
                                        <argument>-Djava.awt.headless=false</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Native .deb: a real desktop entry with a menu icon, a launcher and an uninstall. -->
        <profile>
            <id>linux-installer</id>
            <build>
                <plugins>
                    <!-- 1. Stage the jar that jpackage will wrap. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>prepare-jpackage-input</id>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <phase>package</phase>
                                <configuration>
                                    <outputDirectory>${project.build.directory}/jpackage-input</outputDirectory>
                                    <resources>
                                        <resource>
                                            <directory>${project.build.directory}</directory>
                                            <includes>
                                                <include>${project.build.finalName}.jar</include>
                                            </includes>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.5.0</version>
                        <executions>
                            <!-- 2. Render the app icon from MatrosBadge, so no binary can drift from the brand. -->
                            <execution>
                                <id>generate-icon</id>
                                <goals><goal>exec</goal></goals>
                                <phase>package</phase>
                                <configuration>
                                    <executable>${java.home}/bin/java</executable>
                                    <arguments>
                                        <argument>-cp</argument>
                                        <argument>${project.build.outputDirectory}</argument>
                                        <argument>net.schwehla.matrosdms.desktop.IconGenerator</argument>
                                        <argument>${project.build.directory}/icon/matrosdms.png</argument>
                                    </arguments>
                                </configuration>
                            </execution>

                            <execution>
                                <id>jpackage-linux</id>
                                <goals><goal>exec</goal></goals>
                                <phase>package</phase>
                                <configuration>
                                    <executable>${java.home}/bin/jpackage</executable>
                                    <arguments>
                                        <!-- Linux package names must be lowercase; "MatrosDMS" fails the deb spec. -->
                                        <argument>--name</argument>
                                        <argument>matrosdms</argument>
                                        <argument>--app-version</argument>
                                        <argument>${jpackage.version}</argument>
                                        <argument>--description</argument>
                                        <argument>${app.description}</argument>
                                        <argument>--vendor</argument>
                                        <argument>${app.vendor}</argument>
                                        <argument>--icon</argument>
                                        <argument>${project.build.directory}/icon/matrosdms.png</argument>
                                        <argument>--input</argument>
                                        <argument>${project.build.directory}/jpackage-input</argument>
                                        <argument>--main-jar</argument>
                                        <argument>${project.build.finalName}.jar</argument>
                                        <argument>--dest</argument>
                                        <argument>${project.build.directory}/linux-installer</argument>
                                        <argument>--type</argument>
                                        <argument>deb</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Xmx2048m</argument>
                                        <argument>--java-options</argument>
                                        <argument>-Dspring.profiles.active=prod</argument>
                                        <!-- What makes the tray and splash possible at all: Spring Boot otherwise
                                             forces headless=true and AWT can never open a window. -->
                                        <argument>--java-options</argument>
                                        <argument>-Djava.awt.headless=false</argument>
                                        <argument>--linux-shortcut</argument>
                                        <argument>--linux-menu-group</argument>
                                        <argument>Office</argument>
                                        <argument>--linux-deb-maintainer</argument>
                                        <argument>maintainer@matrosdms.net</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
